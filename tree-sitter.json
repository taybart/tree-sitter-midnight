{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "erde",
      "scope": "source.erde",
      "path": ".",
      "file-types": [
        "erde"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm",
      "tags": "queries/tags.scm",
      "injection-regex": "^erde$",
      "camelcase": "Erde",
      "title": "Erde"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "authors": [
      {
        "name": "Taylor Bartlett",
        "email": "taylor.bartlett@journey.ai"
      },
      {
        "name": "Munif Tanjim",
        "email": "hello@muniftanjim.dev",
        "url": "https://muniftanjim.dev"
      }
    ],
    "links": {
      "repository": "https://github.com/taybart/tree-sitter-erde"
    },
    "description": "Erde grammar for tree-sitter"
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
